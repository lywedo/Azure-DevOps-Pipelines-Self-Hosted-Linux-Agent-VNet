{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "ContainerGroupName": {
            "value": "orchard-uat-agent"
        },
        "numberOfInstances": {
            "value": 1
        },
        "Image": {
            "value": "orchard"
        },
        "ImageVersion": {
            "value": "0.0.2"
        },
        "ADO_Account": {
            "value": "https://dev.azure.com/EastPackDev"
        },
        "ADO_Pool": {
            "value": "container-apps"
        },
        "vnetName": {
            "value": "orchard-vnet"
        },
        "vnetRGName": {
            "value": "rg-myorchard-uat-001"
        },
        "subnetName": {
            "value": "default"
        },
        "subnetPrefix": {
            "value": "10.94.16.0/28"
        },
        "addressPrefixes": {
            "value": ["10.94.16.0/24"]
        },
        "agentCPU": {
            "value": 2
        },
        "agentMem": {
            "value": 4
