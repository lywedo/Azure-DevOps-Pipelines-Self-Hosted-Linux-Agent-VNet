            "value": "rg-myorchard-uat-001"
        },
        "sourceBranch": {
            "value": "main"
        },
        "dockerSourceRepo": {
            "value": "https://github.com/lywedo/Azure-DevOps-Pipelines-Self-Hosted-Linux-Agent-VNet.git"
        },
        "location": {
            "value": "newzealandnorth"
        },
        "agentName": {
            "value": "myorchard-uat"
